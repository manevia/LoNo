{
  "rules": [
    {
      "allowed": {
        "origins": ["https://lono.ciu.edu.lr"],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["Content-Type", "Range"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
