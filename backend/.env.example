# --- Core (required in production) ---
MONGO_URL=mongodb://localhost:27017   # or mongomock:// for an in-memory demo
DB_NAME=lono
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
PUBLIC_ORIGIN=http://localhost:3000   # used for Stripe return URLs
SEED_DEMO_DATA=true

# --- AI: chat assistant + summaries (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Captions: any OpenAI-compatible speech-to-text endpoint ---
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1

# --- Storage: local disk or S3-compatible (AWS S3, Cloudflare R2, MinIO) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
MAX_UPLOAD_MB=100

# --- Google sign-in (Google Identity Services web client ID) ---
GOOGLE_CLIENT_ID=

# --- Payments ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
SIMULATED_TOKEN_PURCHASE=true   # demo button that credits $LONO without payment

# --- Administration and compliance ---
ADMIN_PASSWORD=                     # optional; leave empty for a random one-time password
ADMIN_EMAILS=msf@ciu.edu.lr        # created as admin at startup; password shown once in the server log
TERMS_VERSION=2026-11           # raise when the terms change; users are asked to accept again
SUPPORT_EMAIL=lono@ciu.edu.lr       # shown on the Terms page for privacy requests

# --- Android app (Play Store, built with PWABuilder) ---
ANDROID_APP_PACKAGE=               # e.g. lr.edu.ciu.lono
ANDROID_CERT_SHA256=               # signing key fingerprint(s), comma-separated

# --- Abuse protection ---
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SEC=900
SIGNUPS_PER_IP_PER_HOUR=10

# --- Token economics ---
LONO_PRICE_USD=0.184
SIGNUP_BONUS=100
WATCH_REWARD_PER_MIN=1
WATCH_REWARD_CAP_PER_TITLE=10
WATCH_REWARD_DAILY_CAP=60
HEARTBEAT_SEC=30
CREATOR_COURSE_REWARD=10       # learner reward for passing a creator-published course
CREATOR_PAYOUT_PER_CERT=2      # paid to the creator each time someone else passes
