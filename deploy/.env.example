# LoNo production settings. setup.sh copies this to deploy/.env and fills in the
# secrets. Keep deploy/.env private (it's ignored by git).

# --- Address ---
PUBLIC_HOST=lono.ciu.edu.lr
ACME_EMAIL=msf@ciu.edu.lr                 # Let's Encrypt expiry notices
PUBLIC_ORIGIN=https://lono.ciu.edu.lr
CORS_ORIGINS=https://lono.ciu.edu.lr

# --- Secrets (generated by setup.sh; never reuse the examples) ---
JWT_SECRET=
SECRET_ENC_KEY=
MEDIA_INTERNAL_SECRET=

# --- Database ---
DB_NAME=lono
MONGO_CACHE_GB=1                          # about a quarter of the server's RAM

# --- People ---
ADMIN_EMAILS=msf@ciu.edu.lr
ADMIN_PASSWORD=                           # empty: a one-time password is printed in the API log
SUPPORT_EMAIL=lono@ciu.edu.lr

# --- Content ---
SEED_DEMO_DATA=false                      # true adds the demo catalogue (sample videos from the internet)
MAX_UPLOAD_MB=4096                        # full-match replays are large

# --- Commercial pilot ---
PILOT_MODE=true
PILOT_STARTED_AT=

# --- Live broadcasting: what creators paste into OBS ---
INGEST_RTMP_URL=rtmp://lono.ciu.edu.lr:1935/live
INGEST_RTMPS_URL=                         # set to rtmps://lono.ciu.edu.lr:1936/live once RTMPS=optional
INGEST_SRT_URL=srt://lono.ciu.edu.lr:8890
RTMPS=no                                  # optional: after the certificate exists (setup.sh does this)

# --- Optional services ---
ANTHROPIC_API_KEY=
TRANSCRIBE_API_KEY=
GOOGLE_CLIENT_ID=
STRIPE_API_KEY=
ANDROID_APP_PACKAGE=lr.edu.ciu.lono
ANDROID_CERT_SHA256=
