# Cloudflare static assets: never cache the service worker, manifest or app shell,
# so phones pick up new versions; hashed build files can be cached for a year.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/static/*
  Cache-Control: public, max-age=31536000, immutable
